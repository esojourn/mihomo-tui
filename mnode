#!/usr/bin/env bash
# mnode - mihomo 节点管理 (CLI 版 zashboard)
set -euo pipefail

API="${MIHOMO_API:-http://127.0.0.1:9090}"
SECRET="${MIHOMO_SECRET:-}"
GROUP="${MIHOMO_GROUP:-PROXY}"
TESTURL="http://www.gstatic.com/generate_204"
MIHOMO="${MIHOMO_BIN:-/usr/local/bin/mihomo}"
CONFIG_DIR="${MIHOMO_CONFIG_DIR:-/etc/mihomo}"
CFG="$CONFIG_DIR/config.yaml"
SUB="$CONFIG_DIR/sub.b64"
BUILD="$CONFIG_DIR/build-config.py"
LOCK="$CONFIG_DIR/.mnode.lock"

auth=(); [ -n "$SECRET" ] && auth=(-H "Authorization: Bearer $SECRET")
api() { curl -s "${auth[@]}" "$API$1" "${@:2}"; }

check_up() {
  if ! curl -s --max-time 2 "${auth[@]}" "$API/version" >/dev/null 2>&1; then
    echo "✗ 连不上 mihomo API ($API)。先启动服务: sudo systemctl start mihomo"
    exit 1
  fi
}

current_mode() {
  python3 - "$CFG" <<'PY'
import re, sys
try:
    text = open(sys.argv[1]).read()
except OSError:
    print("mixed")
    raise SystemExit
block = re.search(r"(?ms)^tun:\s*\n((?:^[ \t]+.*\n?)*)", text)
print("tun" if block and re.search(r"(?m)^\s+enable:\s*true\s*$", block.group(1)) else "mixed")
PY
}

show_mode() {
  local mode
  mode=$(current_mode)
  echo "当前接入模式: $mode"
  if [ "$mode" = tun ]; then
    echo "TUN: enabled (system stack, auto-route)"
  else
    echo "Mixed port: 127.0.0.1:7890 (HTTP + SOCKS5)"
  fi
  systemctl is-active --quiet mihomo && echo "服务状态: active" || echo "服务状态: inactive"
}

apply_config() {
  local mode="$1" input="${2:-$SUB}" staging tmpcfg oldmode was_active=0
  oldmode=$(current_mode)
  systemctl is-active --quiet mihomo && was_active=1 || true
  staging=$(mktemp -d "$CONFIG_DIR/.mnode-staging.XXXXXX")
  tmpcfg="$staging/config.yaml"

  if ! python3 "$BUILD" --mode "$mode" --subscription "$input" --output "$tmpcfg"; then
    rm -rf "$staging"
    echo "✗ 生成配置失败，未改动当前配置"
    return 1
  fi
  if ! "$MIHOMO" -d "$CONFIG_DIR" -f "$tmpcfg" -t >/dev/null 2>&1; then
    echo "✗ 配置验证失败，未改动当前配置"
    "$MIHOMO" -d "$CONFIG_DIR" -f "$tmpcfg" -t 2>&1 | tail -5 || true
    rm -rf "$staging"
    return 1
  fi

  cp -p "$CFG" "$CFG.bak"
  [ "$input" = "$SUB" ] || cp -p "$SUB" "$SUB.bak"
  cp -p "$tmpcfg" "$CFG"
  # 配置和订阅必须作为同一次提交；重启失败时二者一起回滚。
  if [ "$input" != "$SUB" ]; then cp -p "$input" "$SUB"; fi
  rm -rf "$staging"

  if [ "$was_active" -eq 1 ]; then
    if ! sudo systemctl restart mihomo || ! systemctl is-active --quiet mihomo; then
      echo "✗ mihomo 重启失败，恢复 $oldmode 配置"
      cp -p "$CFG.bak" "$CFG"
      [ "$input" = "$SUB" ] || cp -p "$SUB.bak" "$SUB"
      sudo systemctl restart mihomo || true
      return 1
    fi
    echo "✓ mihomo 已重启，新配置生效"
  else
    echo "· mihomo 当前未运行，下次 mnode on 时生效"
  fi
  echo "✓ 当前接入模式: $mode"
}

update_config() {
  local input="$SUB" tmp=""
  if [ ! -t 0 ]; then
    tmp=$(mktemp "$CONFIG_DIR/.mnode-sub.XXXXXX")
    cat > "$tmp"
    if [ -s "$tmp" ]; then input="$tmp"; else rm -f "$tmp"; tmp=""; fi
  fi
  apply_config "$(current_mode)" "$input"
  [ -z "$tmp" ] || rm -f "$tmp"
}

cmd="${1:-help}"
case "$cmd" in
  status|st)
    check_up
    ver=$(api /version | python3 -c "import sys,json;print(json.load(sys.stdin).get('version','?'))")
    echo "mihomo 运行中, 版本 $ver, API $API"
    now=$(api "/proxies/$GROUP" | python3 -c "import sys,json;print(json.load(sys.stdin).get('now','?'))")
    echo "当前 [$GROUP] 选中: $now"
    show_mode
    ;;
  mode|m)
    if [ -z "${2:-}" ]; then show_mode; exit 0; fi
    target="$2"; allow_ssh=0
    [ "${3:-}" = "--allow-ssh-risk" ] && allow_ssh=1
    case "$target" in mixed|tun) ;; *) echo "用法: mnode mode [mixed|tun] [--allow-ssh-risk]"; exit 1;; esac
    if [ "$target" = tun ] && { [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_CLIENT:-}" ]; } && [ "$allow_ssh" -ne 1 ]; then
      echo "✗ 检测到 SSH 会话。TUN 自动路由可能导致断联。请使用本地控制台，或显式加 --allow-ssh-risk。"
      exit 1
    fi
    exec 9>"$LOCK"; flock 9
    apply_config "$target"
    ;;
  groups|g)
    check_up
    api /proxies | python3 -c 'import sys,json
d=json.load(sys.stdin)["proxies"]
for k,v in d.items():
    t=v.get("type","")
    if t in ("Selector","URLTest","Fallback","LoadBalance"): print("%s  (%s)  -> now: %s"%(k,t,v.get("now","")))'
    ;;
  list|ls)
    check_up; g="${2:-$GROUP}"
    api "/proxies/$g" | python3 -c 'import sys,json
d=json.load(sys.stdin); now=d.get("now")
for i,name in enumerate(d.get("all",[]),1): print(("*" if name==now else " ")+f" {i:3d}  {name}")' 2>/dev/null || { echo "找不到策略组 '$g'"; exit 1; }
    ;;
  use|u)
    check_up; g="$GROUP"; sel="${2:-}"
    [ -z "$sel" ] && { echo "用法: mnode use <编号|名称> [-g 组名]"; exit 1; }
    if [ "${3:-}" = "-g" ] && [ -n "${4:-}" ]; then g="$4"; fi
    if [[ "$sel" =~ ^[0-9]+$ ]]; then
      sel=$(api "/proxies/$g" | python3 -c "import sys,json;a=json.load(sys.stdin)['all'];print(a[$sel-1] if 0<$sel<=len(a) else '')")
      [ -z "$sel" ] && { echo "编号超出范围"; exit 1; }
    fi
    code=$(curl -s -o /dev/null -w "%{http_code}" "${auth[@]}" -X PUT "$API/proxies/$g" -H "Content-Type: application/json" -d "{\"name\":\"$sel\"}")
    [ "$code" = 204 ] && echo "✓ [$g] 已切换到: $sel" || { echo "✗ 切换失败 (HTTP $code)"; exit 1; }
    ;;
  test|t)
    check_up; g="${2:-$GROUP}"; echo "正在对 [$g] 全部节点测速..."
    api "/group/$g/delay?url=$TESTURL&timeout=5000" | python3 -c 'import sys,json
for name,ms in sorted(json.load(sys.stdin).items(),key=lambda x:x[1]): print(f"{ms:5d} ms  {name}")' || echo "测速失败"
    ;;
  ip)
    check_up; echo "通过 mixed port 查询出口 IP..."
    curl -s --max-time 20 -x http://127.0.0.1:7890 https://ipinfo.io/json | python3 -c "import sys,json;d=json.load(sys.stdin);print('IP:',d.get('ip'),'| 地区:',d.get('country'),d.get('city'),'| ISP:',d.get('org'))" 2>&1 || echo "查询失败"
    ;;
  on) sudo systemctl start mihomo && echo "✓ mihomo 已启动"; sleep 2; "$0" status ;;
  off) sudo systemctl stop mihomo && echo "✓ mihomo 已停止" ;;
  update|up)
    exec 9>"$LOCK"; flock 9
    update_config
    ;;
  help|*)
    cat <<'H'
mnode - mihomo 节点管理

服务: mnode on | off | status
模式: mnode mode [mixed|tun] [--allow-ssh-risk]
节点: mnode groups | list [组] | use <编号|名称> | test [组]
更新: mnode update [< 新订阅文件]
其他: mnode ip

mixed 模式通过 127.0.0.1:7890 提供 HTTP 和 SOCKS5 代理。
tun 模式启用透明代理并同时保留 7890 端口。
远程 SSH 会话切换 tun 默认拒绝，除非显式使用 --allow-ssh-risk。
H
    ;;
esac
